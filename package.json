{
  "name": "mini-nest",
  "version": "0.2.0",
  "description": "Part 2 of 3 — decorator-based HTTP routing and DTO validation on top of the part-1 IoC container, all over node:http with no third-party web framework.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ioc",
    "dependency-injection",
    "decorators",
    "reflect-metadata",
    "http",
    "routing",
    "validation",
    "nestjs"
  ],
  "license": "MIT",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
