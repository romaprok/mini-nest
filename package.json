  "description": "Part 1 of 3 — a hand-written IoC container that mimics what NestJS does under the hood (design:paramtypes reflection, @Injectable/@Inject, scopes, cycle detection).",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
