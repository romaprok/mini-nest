    "clean": "rm -rf dist"
  },
  "keywords": [
    "ioc",
    "dependency-injection",
    "decorators",
    "reflect-metadata",
    "nestjs"
  ],
  "license": "MIT",
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
