{
  "compilerOptions": {
    /* The two flags this whole homework hinges on: the first enables the
       decorator syntax, the second makes TS emit the `design:paramtypes`
       metadata the container/router read to discover constructor deps and
       DTO types on handler parameters. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Modern ESM output that Node 22 runs natively. */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
